<?xml version="1.0"?>
<package format="3">
  <name>so101_driver</name>
  <version>0.2.0</version>
  <description>ROS2 driver node of the SO-ARM101.</description>
  <maintainer email="tek5@epitech.eu">Tek5 Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
