# CONTROL container — ROS2 Jazzy + SO-ARM101 driver (real + MuJoCo sim) + RViz
# Build: docker compose build control
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive \
    MUJOCO_GL=osmesa \
    PYOPENGL_PLATFORM=osmesa \
    LIBGL_ALWAYS_SOFTWARE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    libosmesa6 \
    libgl1 \
    libgl1-mesa-dri \
    ros-jazzy-cv-bridge \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf-transformations \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-rviz2 \
    ros-jazzy-pinocchio \
    socat \
    && rm -rf /var/lib/apt/lists/*

# Provided packages (driver + sim) and ikpy for the IK.
COPY core/lerobot_min /opt/so101/core
COPY sim /opt/so101/sim
RUN pip install --break-system-packages --no-cache-dir \
    "numpy<2" "opencv-python-headless==4.10.*" /opt/so101/core /opt/so101/sim ikpy

# ROS2 workspace mounted as a volume (see docker-compose.yml)
WORKDIR /ros2_ws

# RViz: needs forwarded X11 (DISPLAY + /tmp/.X11-unix, see compose)
# and `xhost +local:docker` on the host. Without GPU acceleration in the
# container, fallback: LIBGL_ALWAYS_SOFTWARE=1 rviz2
# Serial bus access for the real arm: see compose (device_cgroup_rules)
CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && bash"]
